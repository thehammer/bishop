#!/usr/bin/env bash
# bishop — Claude Code budget-posture producer
# Primary: reads Anthropic OAuth /api/oauth/usage endpoint via bishop-fetch-usage.
# Fallback: reads ~/.mother/rate-limits.json (Mother aggregate).
# Writes ~/.claude/budget-posture.json (atomic, idempotent, safe to run concurrently).
set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration (all overridable for testing)
# ---------------------------------------------------------------------------
: "${BISHOP_SOURCE_PATH:=$HOME/.mother/rate-limits.json}"
: "${BISHOP_OUTPUT_PATH:=$HOME/.claude/budget-posture.json}"
: "${BISHOP_SOURCE_STALE_SECONDS:=600}"
: "${BISHOP_USAGE_FETCH_CMD:=$(dirname "$0")/bishop-fetch-usage}"
: "${BISHOP_USAGE_CACHE_PATH:=$HOME/.claude/oauth-usage.json}"
: "${BISHOP_USAGE_CACHE_TTL_SECONDS:=55}"
: "${BISHOP_PACE_SMOOTH_WINDOW_SECONDS:=2700}"
: "${BISHOP_PACE_SMOOTH_MIN_SAMPLES:=3}"
: "${BISHOP_MOTHER_RUNS_PATH:=$HOME/.mother/metrics/runs.jsonl}"
: "${BISHOP_EVENTS_PATH:=$HOME/.claude/budget-posture.events.jsonl}"
: "${BISHOP_EVENTS_MAX_BYTES:=1048576}"          # 1 MB — rotate beyond this
: "${BISHOP_EXHAUSTION_IMMINENT_SECONDS:=1800}"  # 30 minutes
: "${BISHOP_EVENT_TS_OVERRIDE:-}"                # testing only — pin event timestamps

LOCK_PATH="${BISHOP_OUTPUT_PATH}.lock"
ERR_LOG="${HOME}/.claude/budget-posture.errors.log"
STATE_PATH="${BISHOP_OUTPUT_PATH}.state"
PACE_HISTORY_PATH="${BISHOP_OUTPUT_PATH}.pace-history.json"
ERR_LOG_MAX=102400  # 100 KB

# ---------------------------------------------------------------------------
# Internal helpers
# ---------------------------------------------------------------------------

_bishop_log_err() {
  local msg="[$(date -u +%FT%TZ)] bishop: $*"
  # Rotate log at 100 KB
  if [[ -f "$ERR_LOG" ]]; then
    local size
    size=$(stat -f %z "$ERR_LOG" 2>/dev/null || echo 0)
    if [[ "$size" -gt "$ERR_LOG_MAX" ]]; then
      mv "$ERR_LOG" "${ERR_LOG}.1"
      : > "$ERR_LOG"
    fi
  fi
  echo "$msg" >> "$ERR_LOG" 2>/dev/null || true
}

_bishop_now() {
  if [[ -n "${BISHOP_NOW_OVERRIDE:-}" ]]; then
    echo "$BISHOP_NOW_OVERRIDE"
  else
    date +%s
  fi
}

_bishop_source_mtime() {
  if [[ -n "${BISHOP_MTIME_OVERRIDE:-}" ]]; then
    echo "$BISHOP_MTIME_OVERRIDE"
  else
    stat -f %m "$BISHOP_SOURCE_PATH" 2>/dev/null || echo 0
  fi
}

_bishop_file_mtime() {
  local file="$1"
  stat -f %m "$file" 2>/dev/null || echo 0
}

_bishop_agents_json() {
  local now="$1"
  local runs_path="${BISHOP_MOTHER_RUNS_PATH}"
  if [[ ! -r "$runs_path" ]]; then
    echo '{}'
    return 0
  fi
  local fh_start sd_start
  fh_start=$(( now - 18000 ))
  sd_start=$(( now - 604800 ))
  jq -R -n -c \
    --argjson now "$now" \
    --argjson fh_start "$fh_start" \
    --argjson sd_start "$sd_start" \
    '
    def parse_iso:
      sub("\\.[0-9]+(?=[+Z])"; "")
      | sub("\\+00:00$"; "Z")
      | fromdateiso8601;
    reduce (inputs
            | . as $line
            | (try fromjson catch empty)
            | select(type == "object")
            | select(.outcome == "succeeded")
            | select(.stage != null and (.stage|type) == "string")
            | . as $r
            | ($r.ts | try parse_iso catch empty) as $ets
            | select($ets != null and ($ets >= $sd_start) and ($ets <= $now))
            | { stage: $r.stage,
                ts: $ets,
                tin:  (($r.tokens_in  // 0) | if type == "number" then . else 0 end),
                tout: (($r.tokens_out // 0) | if type == "number" then . else 0 end) }
           ) as $rec ({};
      ($rec.ts >= $fh_start and $rec.ts <= $now) as $in5h
      | .[$rec.stage] = ((.[$rec.stage]) //
          {tokens_in_5h:0, tokens_out_5h:0, tokens_in_7d:0, tokens_out_7d:0})
      | .[$rec.stage].tokens_in_7d  += $rec.tin
      | .[$rec.stage].tokens_out_7d += $rec.tout
      | (if $in5h then
           .[$rec.stage].tokens_in_5h  += $rec.tin
           | .[$rec.stage].tokens_out_5h += $rec.tout
         else . end))
    ' "$runs_path" 2>/dev/null || echo '{}'
}

_bishop_append_event() {
  local line="$1"
  [[ -z "$line" ]] && return 0
  local path="${BISHOP_EVENTS_PATH}"
  local max="${BISHOP_EVENTS_MAX_BYTES:-1048576}"
  if [[ -f "$path" ]]; then
    local size
    size="$(stat -f %z "$path" 2>/dev/null || echo 0)"
    if [[ "$size" -ge "$max" ]]; then
      mv "$path" "${path}.1" 2>/dev/null || true
    fi
  fi
  local tmp="${path}.tmp.$$"
  if [[ -f "$path" ]]; then
    cat "$path" > "$tmp" 2>/dev/null || : > "$tmp"
  else
    : > "$tmp"
  fi
  printf '%s\n' "$line" >> "$tmp" 2>/dev/null || true
  mv "$tmp" "$path" 2>/dev/null || rm -f "$tmp"
  return 0
}

# Detect threshold crossings by comparing prev and new posture JSON.
# Appends structured JSON-lines events to BISHOP_EVENTS_PATH.
# Must never let errors escape — all error paths return 0.
_bishop_emit_events() {
  local prev_json="$1"
  local now="$2"
  local new_json
  new_json="$(cat "${BISHOP_OUTPUT_PATH}" 2>/dev/null || true)"
  [[ -z "$new_json" ]] && return 0

  local event_ts="${BISHOP_EVENT_TS_OVERRIDE:-$(date -u +%FT%TZ)}"

  local window
  for window in five_hour seven_day; do
    local prev_level new_level new_pace
    new_level="$(printf '%s' "$new_json"  | jq -r ".${window}.level  // empty" 2>/dev/null || true)"
    new_pace="$( printf '%s' "$new_json"  | jq -r ".${window}.pace   // empty" 2>/dev/null || true)"
    [[ -z "$new_level" ]] && continue

    local trigger=""
    if [[ -n "$prev_json" ]]; then
      prev_level="$(printf '%s' "$prev_json" | jq -r ".${window}.level // empty" 2>/dev/null || true)"

      if [[ "$new_level" == "Pump the brakes" && "$prev_level" != "Pump the brakes" ]]; then
        trigger="pace_critical"
      elif [[ "$new_level" == "Ease up" && "$prev_level" != "Ease up" ]]; then
        trigger="pace_warning"
      elif [[ "$new_level" != "Pump the brakes" && "$new_level" != "Ease up" &&
              ( "$prev_level" == "Pump the brakes" || "$prev_level" == "Ease up" ) ]]; then
        trigger="pace_recovered"
      fi
    fi

    if [[ -n "$trigger" ]]; then
      local line
      line="$(jq -c -n \
        --arg ts "$event_ts" \
        --arg window "$window" \
        --arg trigger "$trigger" \
        --argjson pace "${new_pace:-null}" \
        '{ts:$ts,type:"threshold_crossed",window:$window,trigger:$trigger}
         + (if $pace == null then {} else {pace:$pace} end)' 2>/dev/null || true)"
      _bishop_append_event "$line" || true
    fi

    # Exhaustion imminence check (edge-triggered)
    local new_pe prev_pe
    new_pe="$(printf '%s' "$new_json"  | jq -r ".${window}.projected_exhaustion // empty" 2>/dev/null || true)"
    if [[ -n "$new_pe" ]]; then
      local new_pe_epoch secs_remaining
      new_pe_epoch="$(printf '%s' "\"$new_pe\"" | jq -r 'fromdateiso8601' 2>/dev/null || true)"
      if [[ -n "$new_pe_epoch" ]]; then
        secs_remaining=$(( ${new_pe_epoch%.*} - now ))
        if [[ "$secs_remaining" -lt "${BISHOP_EXHAUSTION_IMMINENT_SECONDS:-1800}" ]]; then
          local already_imminent=0
          if [[ -n "$prev_json" ]]; then
            prev_pe="$(printf '%s' "$prev_json" | jq -r ".${window}.projected_exhaustion // empty" 2>/dev/null || true)"
            if [[ -n "$prev_pe" ]]; then
              local prev_pe_epoch prev_secs
              prev_pe_epoch="$(printf '%s' "\"$prev_pe\"" | jq -r 'fromdateiso8601' 2>/dev/null || true)"
              if [[ -n "$prev_pe_epoch" ]]; then
                prev_secs=$(( ${prev_pe_epoch%.*} - now ))
                [[ "$prev_secs" -lt "${BISHOP_EXHAUSTION_IMMINENT_SECONDS:-1800}" ]] && already_imminent=1
              fi
            fi
          fi
          if [[ "$already_imminent" -eq 0 ]]; then
            local mins=$(( secs_remaining / 60 ))
            local line
            line="$(jq -c -n \
              --arg ts "$event_ts" \
              --arg window "$window" \
              --argjson mins "$mins" \
              '{ts:$ts,type:"threshold_crossed",window:$window,trigger:"exhaustion_imminent",minutes_remaining:$mins}' \
              2>/dev/null || true)"
            _bishop_append_event "$line" || true
          fi
        fi
      fi
    fi
  done

  # overage_started (top-level, edge-triggered)
  if [[ -n "$prev_json" ]]; then
    local prev_bm new_bm
    new_bm="$( printf '%s' "$new_json"  | jq -r '.billing_mode // empty' 2>/dev/null || true)"
    prev_bm="$(printf '%s' "$prev_json" | jq -r '.billing_mode // empty' 2>/dev/null || true)"
    if [[ "$new_bm" == "metered" && "$prev_bm" != "metered" ]]; then
      local line
      line="$(jq -c -n \
        --arg ts "$event_ts" \
        '{ts:$ts,type:"threshold_crossed",window:"account",trigger:"overage_started"}' \
        2>/dev/null || true)"
      _bishop_append_event "$line" || true
    fi
  fi
  return 0
}

# ---------------------------------------------------------------------------
# jq program: translate OAuth response → posture output
#
# The window math is inlined because jq does not support sourcing external
# programs and we need it in one self-contained expression for performance.
# ---------------------------------------------------------------------------

_BISHOP_OAUTH_JQ_PROGRAM='
# Strip fractional seconds and normalize +00:00 → Z before ISO parse
# (macOS jq fromdateiso8601 only accepts Z-suffix UTC, not +00:00)
def parse_iso:
  sub("\\.[0-9]+(?=[+Z])"; "")
  | sub("\\+00:00$"; "Z")
  | fromdateiso8601;

def window_seconds(key): if key == "five_hour" then 18000 else 604800 end;

def level_for(key; p):
  if key == "five_hour" then
    (if p > 1.4 then "Pump the brakes"
     elif p > 1.1 then "Ease up"
     elif p >= 0.85 then "Cruise"
     elif p >= 0.6 then "Push"
     else "Put the hammer down" end)
  else
    (if p > 1.3 then "Pump the brakes"
     elif p > 1.0 then "Ease up"
     elif p >= 0.85 then "Cruise"
     elif p >= 0.6 then "Push"
     else "Put the hammer down" end)
  end;

# Plan name is inferred from token limits, not reported by the API. The OAuth
# usage endpoint currently returns only utilization percentages (no absolute
# limit), so plan is null in practice. Thresholds are approximate; ambiguous.
def plan_name(fh; sd):
  if sd == null then null
  elif sd >= 1500000 then "Max 20x"
  elif sd >= 300000  then "Max 5x"
  else "Pro"
  end;

def posture_for(fh_level; sd_level):
  (["Pump the brakes","Ease up","Cruise","Push","Put the hammer down"]) as $rank
  | ([fh_level, sd_level]
     | map(. as $l | {l: $l, r: ($rank | index($l))})
     | min_by(.r) | .l);

def compute_window(key; src; now):
  src[key] as $w
  | window_seconds(key) as $ws
  | ($w.used_percentage // 0) as $used
  | ($w.resets_at // 0) as $resets
  | (($ws - ($resets - now)) / $ws * 100) as $raw_elapsed
  | (if $raw_elapsed < 0 then 0 elif $raw_elapsed > 100 then 100 else $raw_elapsed end) as $elapsed
  | (if $elapsed < 2 then null
     else ($used / (if $elapsed < 1 then 1 else $elapsed end))
     end) as $pace
  | (if $pace == null or $used <= 0 or $used >= 100 then null
     else
       ($ws * ($elapsed / 100)) as $elapsed_secs
       | (now + ($elapsed_secs * (100 - $used) / $used)) as $ee
       | (if $ee >= $resets then null else ($ee | floor | todateiso8601) end)
     end) as $projected_exhaustion
  | {
      used_pct: $used,
      elapsed_pct: ($elapsed | . * 10 | round / 10),
      pace: (if $pace == null then null else ($pace * 100 | round / 100) end),
      projected_exhaustion: $projected_exhaustion,
      resets_at: $resets,
      level: (if $pace == null then "Cruise" else level_for(key; $pace) end)
    };

def model_entry(key):
  .[key] as $bucket
  | if $bucket == null then null
    else
      ($bucket.resets_at | parse_iso) as $resets
      | if $resets <= $now then null
        else
          {
            status: (if ($bucket.utilization // 0) >= 100 then "exhausted" else "active" end),
            used_pct: ($bucket.utilization // 0),
            resets_at: $resets
          }
        end
    end;

. as $oauth
# Normalize to posture-math shape
| {
    five_hour: {
      used_percentage: ($oauth.five_hour.utilization // 0),
      resets_at: ($oauth.five_hour.resets_at | parse_iso)
    },
    seven_day: {
      used_percentage: ($oauth.seven_day.utilization // 0),
      resets_at: ($oauth.seven_day.resets_at | parse_iso)
    }
  } as $normalized
| compute_window("five_hour"; $normalized; $now) as $fh
| compute_window("seven_day"; $normalized; $now) as $sd

# Pace smoothing: blend recent history with current reading
| ([ $pace_history[] | select(($now - .ts) <= $smooth_window) ]) as $recent
| (($recent | map(.fh) | map(select(. != null))) + (if $fh.pace == null then [] else [$fh.pace] end)) as $fh_samples
| (($recent | map(.sd) | map(select(. != null))) + (if $sd.pace == null then [] else [$sd.pace] end)) as $sd_samples
| (if ($fh_samples | length) >= $smooth_min
   then (($fh_samples | add) / ($fh_samples | length) * 100 | round / 100)
   else null end) as $fh_smoothed
| (if ($sd_samples | length) >= $smooth_min
   then (($sd_samples | add) / ($sd_samples | length) * 100 | round / 100)
   else null end) as $sd_smoothed

# Smoothed level drives posture roll-up; fall back to raw level when no smoothed value
| (if $fh_smoothed == null then $fh.level else level_for("five_hour"; $fh_smoothed) end) as $fh_eff_level
| (if $sd_smoothed == null then $sd.level else level_for("seven_day"; $sd_smoothed) end) as $sd_eff_level
| posture_for($fh_eff_level; $sd_eff_level) as $posture

| model_entry("seven_day_sonnet") as $sonnet
| model_entry("seven_day_opus")   as $opus
| model_entry("seven_day_haiku")  as $haiku
| [
    (if $sonnet != null and $sonnet.status == "exhausted" then "sonnet" else empty end),
    (if $opus   != null and $opus.status   == "exhausted" then "opus"   else empty end),
    (if $haiku  != null and $haiku.status  == "exhausted" then "haiku"  else empty end)
  ] as $exhausted_models
| ($oauth.extra_usage // {}) as $eu
| {
    ts: ($now | todateiso8601),
    source: "oauth_usage",
    posture: (if $stale_input then "Cruise" else $posture end),
    five_hour: ($fh + {pace_smoothed: $fh_smoothed}),
    seven_day: ($sd + {pace_smoothed: $sd_smoothed}),
    models: { sonnet: $sonnet, opus: $opus, haiku: $haiku },
    exhausted_models: $exhausted_models,
    agents: $agents,
    billing_mode: (if ($eu.is_enabled // false) and (($eu.used_credits // 0) > 0)
                   then "metered" else "subscription" end),
    overage: {
      enabled: ($eu.is_enabled // false),
      spent_usd: (if ($eu.used_credits // null) == null then null
                  else (($eu.used_credits / 100) * 100 | round / 100) end),
      monthly_limit_usd: ($eu.monthly_limit // null),
      this_session_usd: null
    },
    subscription: {
      plan: plan_name(($oauth.five_hour.limit // null); ($oauth.seven_day.limit // null)),
      limits: {
        five_hour: ($oauth.five_hour.limit // null),
        seven_day: ($oauth.seven_day.limit // null)
      }
    },
    extra_usage: {
      is_enabled:    ($eu.is_enabled    // false),
      used_credits:  ($eu.used_credits  // null),
      currency:      ($eu.currency      // "USD"),
      monthly_limit: ($eu.monthly_limit // null),
      utilization:   ($eu.utilization   // null)
    },
    source_mtime: ($source_mtime | todateiso8601),
    source_age_seconds: ($now - $source_mtime),
    stale_input: $stale_input
  }
'

# ---------------------------------------------------------------------------
# jq program: translate Mother aggregate → posture output (legacy path)
# ---------------------------------------------------------------------------

_BISHOP_JQ_PROGRAM='
def window_seconds(key): if key == "five_hour" then 18000 else 604800 end;

def compute_window(key; now):
  .[key] as $w
  | window_seconds(key) as $ws
  | ($w.used_percentage // 0) as $used
  | ($w.resets_at // 0) as $resets
  | (($ws - ($resets - now)) / $ws * 100) as $raw_elapsed
  | (if $raw_elapsed < 0 then 0 elif $raw_elapsed > 100 then 100 else $raw_elapsed end) as $elapsed
  | (if $elapsed < 2 then null
     else ($used / (if $elapsed < 1 then 1 else $elapsed end))
     end) as $pace
  | (if $pace == null or $used <= 0 or $used >= 100 then null
     else
       ($ws * ($elapsed / 100)) as $elapsed_secs
       | (now + ($elapsed_secs * (100 - $used) / $used)) as $ee
       | (if $ee >= $resets then null else ($ee | floor | todateiso8601) end)
     end) as $projected_exhaustion
  | {
      used_pct: $used,
      elapsed_pct: ($elapsed | . * 10 | round / 10),
      pace: (if $pace == null then null else ($pace * 100 | round / 100) end),
      projected_exhaustion: $projected_exhaustion,
      resets_at: $resets,
      level: (
        if $pace == null then "Cruise"
        elif key == "five_hour" then
          (if $pace > 1.4 then "Pump the brakes"
           elif $pace > 1.1 then "Ease up"
           elif $pace >= 0.85 then "Cruise"
           elif $pace >= 0.6 then "Push"
           else "Put the hammer down" end)
        else
          (if $pace > 1.3 then "Pump the brakes"
           elif $pace > 1.0 then "Ease up"
           elif $pace >= 0.85 then "Cruise"
           elif $pace >= 0.6 then "Push"
           else "Put the hammer down" end)
        end
      )
    };

. as $src
| compute_window("five_hour"; $now) as $fh
| compute_window("seven_day"; $now) as $sd
| (["Pump the brakes","Ease up","Cruise","Push","Put the hammer down"]) as $rank
| (
    [$fh.level, $sd.level]
    | map(. as $level | {l: $level, r: ($rank | index($level))})
    | min_by(.r) | .l
  ) as $posture
| {
    ts: ($now | todateiso8601),
    source: "mother_aggregate",
    posture: $posture,
    five_hour: ($fh + {pace_smoothed: null}),
    seven_day: ($sd + {pace_smoothed: null}),
    models: { sonnet: null, opus: null, haiku: null },
    exhausted_models: [],
    agents: {},
    billing_mode: "subscription",
    overage: {
      enabled: false,
      spent_usd: null,
      monthly_limit_usd: null,
      this_session_usd: null
    },
    subscription: {
      plan: null,
      limits: { five_hour: null, seven_day: null }
    },
    extra_usage: null,
    source_mtime: ($source_mtime | todateiso8601),
    source_age_seconds: ($now - $source_mtime),
    stale_input: ($now - $source_mtime > $stale_seconds)
  }
| if .stale_input then .posture = "Cruise" else . end
'

# ---------------------------------------------------------------------------
# Subcommand: --refresh
# ---------------------------------------------------------------------------

_bishop_refresh() {
  # Short-circuit if disabled
  if [[ -n "${BISHOP_DISABLED:-}" ]]; then
    exit 0
  fi

  # Acquire exclusive lock if flock is available; otherwise proceed unlocked
  local use_flock=0
  command -v flock >/dev/null 2>&1 && use_flock=1

  if [[ "$use_flock" -eq 1 ]]; then
    exec 9>"$LOCK_PATH"
    if ! flock -n 9; then
      # Another instance is refreshing; skip
      exit 0
    fi
  fi

  local now
  now="$(_bishop_now)"

  # Capture previous posture BEFORE overwriting — used for edge-triggered events
  local prev_posture_json=""
  if [[ -f "${BISHOP_OUTPUT_PATH}" ]]; then
    prev_posture_json="$(cat "${BISHOP_OUTPUT_PATH}" 2>/dev/null || true)"
  fi

  local tmp_output
  tmp_output="${BISHOP_OUTPUT_PATH}.tmp.$$"

  # Read pace history for smoothed-pace computation on the OAuth path
  local pace_history="[]"
  if [[ -f "$PACE_HISTORY_PATH" ]]; then
    pace_history="$(cat "$PACE_HISTORY_PATH" 2>/dev/null || echo '[]')"
    [[ -z "$pace_history" ]] && pace_history="[]"
  fi

  # -------------------------------------------------------------------------
  # OAuth path: try bishop-fetch-usage with TTL-based cache
  # -------------------------------------------------------------------------
  local oauth_source=""   # "fresh" | "cached" | ""
  local oauth_data=""

  # Check if we have a fresh cached OAuth response
  if [[ -f "$BISHOP_USAGE_CACHE_PATH" ]]; then
    local cache_mtime cache_age
    cache_mtime="$(_bishop_file_mtime "$BISHOP_USAGE_CACHE_PATH")"
    cache_age=$(( now - cache_mtime ))
    if [[ "$cache_age" -lt "$BISHOP_USAGE_CACHE_TTL_SECONDS" ]]; then
      oauth_data="$(cat "$BISHOP_USAGE_CACHE_PATH" 2>/dev/null || true)"
      if [[ -n "$oauth_data" ]]; then
        oauth_source="cached"
      fi
    fi
  fi

  # If no fresh cache, attempt a live fetch
  if [[ -z "$oauth_source" ]]; then
    if [[ -x "${BISHOP_USAGE_FETCH_CMD:-}" ]]; then
      local fetch_out fetch_exit
      fetch_out="$("$BISHOP_USAGE_FETCH_CMD" 2>/dev/null)" && fetch_exit=0 || fetch_exit=$?

      if [[ "$fetch_exit" -eq 0 ]] && [[ -n "$fetch_out" ]]; then
        local tmp_cache
        tmp_cache="${BISHOP_USAGE_CACHE_PATH}.tmp.$$"
        printf '%s\n' "$fetch_out" > "$tmp_cache"
        mv "$tmp_cache" "$BISHOP_USAGE_CACHE_PATH"
        oauth_data="$fetch_out"
        oauth_source="fresh"
      else
        # Any non-zero exit: log and keep stale cache if available
        if [[ "$fetch_exit" -eq 3 ]]; then
          _bishop_log_err "OAuth fetch rate-limited (429); keeping stale cache"
        elif [[ "$fetch_exit" -eq 2 ]]; then
          _bishop_log_err "OAuth token not found in keychain; keeping stale cache"
        else
          _bishop_log_err "OAuth fetch failed (exit $fetch_exit); keeping stale cache"
        fi
        if [[ -f "$BISHOP_USAGE_CACHE_PATH" ]]; then
          oauth_data="$(cat "$BISHOP_USAGE_CACHE_PATH" 2>/dev/null || true)"
          [[ -n "$oauth_data" ]] && oauth_source="cached"
        fi
      fi
    else
      _bishop_log_err "bishop-fetch-usage not found or not executable: ${BISHOP_USAGE_FETCH_CMD:-unset}"
    fi
  fi

  # -------------------------------------------------------------------------
  # If we have OAuth data, produce output from it
  # -------------------------------------------------------------------------
  if [[ -n "$oauth_source" ]] && [[ -n "$oauth_data" ]]; then
    local cache_mtime cache_age stale_input
    cache_mtime="$(_bishop_file_mtime "$BISHOP_USAGE_CACHE_PATH")"
    cache_age=$(( now - cache_mtime ))
    if [[ "$cache_age" -gt "$BISHOP_SOURCE_STALE_SECONDS" ]]; then
      stale_input="true"
      _bishop_log_err "OAuth cache is stale (${cache_age}s old); posture forced to normal"
    else
      stale_input="false"
    fi

    local agents_json
    agents_json="$(_bishop_agents_json "$now")"
    [[ -z "$agents_json" ]] && agents_json='{}'

    if printf '%s' "$oauth_data" | jq \
        --argjson now "$now" \
        --argjson source_mtime "$cache_mtime" \
        --argjson stale_input "$stale_input" \
        --argjson pace_history "$pace_history" \
        --argjson smooth_window "$BISHOP_PACE_SMOOTH_WINDOW_SECONDS" \
        --argjson smooth_min "$BISHOP_PACE_SMOOTH_MIN_SAMPLES" \
        --argjson agents "$agents_json" \
        "$_BISHOP_OAUTH_JQ_PROGRAM" > "$tmp_output" 2>/dev/null; then
      mv "$tmp_output" "$BISHOP_OUTPUT_PATH"
      _bishop_emit_events "$prev_posture_json" "$now" || true

      # Update pace history (failure must not affect exit code — never-crash contract)
      local fh_pace sd_pace
      fh_pace="$(jq -r '.five_hour.pace // empty' "$BISHOP_OUTPUT_PATH" 2>/dev/null || true)"
      sd_pace="$(jq -r '.seven_day.pace // empty' "$BISHOP_OUTPUT_PATH" 2>/dev/null || true)"
      local tmp_hist="${PACE_HISTORY_PATH}.tmp.$$"
      if printf '%s' "$pace_history" | jq \
          --argjson now "$now" \
          --argjson win "$BISHOP_PACE_SMOOTH_WINDOW_SECONDS" \
          --argjson fh "${fh_pace:-null}" \
          --argjson sd "${sd_pace:-null}" \
          '(. + [{ts:$now, fh:$fh, sd:$sd}]) | map(select(($now - .ts) <= $win)) | .[-120:]' \
          > "$tmp_hist" 2>/dev/null; then
        mv "$tmp_hist" "$PACE_HISTORY_PATH"
      else
        rm -f "$tmp_hist"
      fi

      exit 0
    else
      _bishop_log_err "jq failed parsing OAuth data; falling back to Mother aggregate"
      rm -f "$tmp_output"
    fi
  fi

  # -------------------------------------------------------------------------
  # Fallback: Mother aggregate (legacy path — exactly as before)
  # -------------------------------------------------------------------------
  if [[ ! -f "$BISHOP_SOURCE_PATH" ]]; then
    _bishop_log_err "source not found: $BISHOP_SOURCE_PATH"
    exit 0
  fi

  local mtime
  mtime="$(_bishop_source_mtime)"

  if [[ -f "$STATE_PATH" ]]; then
    local saved_mtime
    saved_mtime="$(cat "$STATE_PATH" 2>/dev/null || echo 0)"
    if [[ "$mtime" == "$saved_mtime" ]]; then
      exit 0
    fi
  fi

  if ! jq \
    --argjson now "$now" \
    --argjson source_mtime "$mtime" \
    --argjson stale_seconds "$BISHOP_SOURCE_STALE_SECONDS" \
    "$_BISHOP_JQ_PROGRAM" \
    "$BISHOP_SOURCE_PATH" > "$tmp_output" 2>/dev/null; then
    _bishop_log_err "jq failed on $BISHOP_SOURCE_PATH"
    rm -f "$tmp_output"
    exit 0
  fi

  mv "$tmp_output" "$BISHOP_OUTPUT_PATH"
  _bishop_emit_events "$prev_posture_json" "$now" || true

  local tmp_state
  tmp_state="${STATE_PATH}.tmp.$$"
  echo "$mtime" > "$tmp_state"
  mv "$tmp_state" "$STATE_PATH"

  exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: status [--json]
# ---------------------------------------------------------------------------

_bishop_status() {
  local json_mode=0
  if [[ "${1:-}" == "--json" ]]; then
    json_mode=1
  fi

  if [[ "$json_mode" -eq 1 ]]; then
    if [[ ! -f "$BISHOP_OUTPUT_PATH" ]]; then
      echo "{}"
      exit 0
    fi
    cat "$BISHOP_OUTPUT_PATH"
    exit 0
  fi

  # Human-readable
  if [[ ! -f "$BISHOP_OUTPUT_PATH" ]]; then
    echo "unknown (no posture file)"
    exit 0
  fi

  local posture fh_level sd_level age source
  posture="$(jq -r '.posture // "unknown"' "$BISHOP_OUTPUT_PATH" 2>/dev/null || echo "unknown")"
  fh_level="$(jq -r '.five_hour.level // "unknown"' "$BISHOP_OUTPUT_PATH" 2>/dev/null || echo "unknown")"
  sd_level="$(jq -r '.seven_day.level // "unknown"' "$BISHOP_OUTPUT_PATH" 2>/dev/null || echo "unknown")"
  age="$(jq -r '.source_age_seconds // 0 | floor' "$BISHOP_OUTPUT_PATH" 2>/dev/null || echo "0")"
  source="$(jq -r '.source // "unknown"' "$BISHOP_OUTPUT_PATH" 2>/dev/null || echo "unknown")"

  echo "${posture} (5h: ${fh_level} · 7d: ${sd_level} · age ${age}s)"

  if [[ "$source" == "oauth_usage" ]]; then
    local overage_enabled
    overage_enabled="$(jq -r '.extra_usage.is_enabled // false' "$BISHOP_OUTPUT_PATH" 2>/dev/null || echo "false")"

    _format_model() {
      local name="$1"
      local entry
      entry="$(jq -c --arg n "$name" '.models[$n]' "$BISHOP_OUTPUT_PATH" 2>/dev/null || echo "null")"
      if [[ "$entry" == "null" ]]; then
        printf '%s none' "$name"
        return
      fi
      local status used_pct resets_at now secs_left remain_str suffix
      status="$(printf '%s' "$entry"   | jq -r '.status'   2>/dev/null || echo "active")"
      used_pct="$(printf '%s' "$entry" | jq -r '.used_pct' 2>/dev/null || echo "0")"
      resets_at="$(printf '%s' "$entry"| jq -r '.resets_at' 2>/dev/null || echo "0")"
      now="$(_bishop_now)"
      secs_left=$(( resets_at - now ))
      if [[ "$secs_left" -le 0 ]]; then
        remain_str="now"
      else
        local d h
        d=$(( secs_left / 86400 ))
        h=$(( (secs_left % 86400) / 3600 ))
        if [[ "$d" -gt 0 ]]; then remain_str="${d}d${h}h"; else remain_str="${h}h"; fi
      fi
      suffix=""
      if [[ "$status" == "exhausted" ]] && [[ "$overage_enabled" == "true" ]]; then
        suffix="*"
      fi
      if [[ "$status" == "exhausted" ]]; then
        printf '%s %s%% EXHAUSTED (resets %s)%s' "$name" "$used_pct" "$remain_str" "$suffix"
      else
        printf '%s %s%%' "$name" "$used_pct"
      fi
    }

    local sonnet_str opus_str haiku_str
    sonnet_str="$(_format_model sonnet)"
    opus_str="$(_format_model opus)"
    haiku_str="$(_format_model haiku)"
    printf 'models:  %s  %s  %s\n' "$sonnet_str" "$opus_str" "$haiku_str"

    if [[ "$overage_enabled" == "true" ]]; then
      local used_credits currency monthly_limit dollars
      used_credits="$(jq -r '.extra_usage.used_credits // 0' "$BISHOP_OUTPUT_PATH" 2>/dev/null || echo "0")"
      currency="$(jq -r '.extra_usage.currency // "USD"' "$BISHOP_OUTPUT_PATH" 2>/dev/null || echo "USD")"
      monthly_limit="$(jq -r '.extra_usage.monthly_limit // "null"' "$BISHOP_OUTPUT_PATH" 2>/dev/null || echo "null")"
      if [[ "$currency" == "USD" ]]; then
        dollars="$(printf '%.2f' "$(echo "scale=2; $used_credits / 100" | bc 2>/dev/null || echo "$used_credits")")"
        if [[ "$monthly_limit" != "null" ]]; then
          printf 'overage: $%s used (allowed, limit: $%s)\n' "$dollars" "$monthly_limit"
        else
          printf 'overage: $%s used (allowed)\n' "$dollars"
        fi
      else
        printf 'overage: %s %s used (allowed)\n' "$used_credits" "$currency"
      fi
    fi
  else
    echo "models: aggregate only (no per-model data — bishop-fetch-usage failed)"
  fi

  exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: get <field>
# ---------------------------------------------------------------------------

_bishop_get() {
  local field="${1:-}"
  if [[ -z "$field" ]]; then
    echo "Usage: bishop get <field>" >&2
    exit 1
  fi

  if [[ ! -f "$BISHOP_OUTPUT_PATH" ]]; then
    exit 0
  fi

  jq -r ".${field} // empty" "$BISHOP_OUTPUT_PATH" 2>/dev/null || true
  exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: install-agent
# ---------------------------------------------------------------------------

_bishop_install_agent() {
  local plist_template plist_dest bin_path real_bin
  real_bin="${BASH_SOURCE[0]}"
  if command -v readlink >/dev/null 2>&1; then
    real_bin="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
  fi
  plist_template="$(cd "$(dirname "$real_bin")/.." && pwd)/launchd/com.user.bishop.refresh.plist"
  plist_dest="${HOME}/Library/LaunchAgents/com.user.bishop.refresh.plist"
  bin_path="$(cd "$(dirname "$real_bin")" && pwd)/bishop"

  if [[ ! -f "$plist_template" ]]; then
    echo "Error: plist template not found at $plist_template" >&2
    exit 1
  fi

  mkdir -p "${HOME}/Library/LaunchAgents"

  sed -e "s|__BISHOP_BIN__|${bin_path}|g" \
      -e "s|__HOME__|${HOME}|g" \
      "$plist_template" > "$plist_dest"

  launchctl bootout "gui/$(id -u)/com.user.bishop.refresh" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist_dest"

  echo "Installed and loaded com.user.bishop.refresh (runs every 60s)"
  exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: uninstall-agent
# ---------------------------------------------------------------------------

_bishop_uninstall_agent() {
  local plist_dest
  plist_dest="${HOME}/Library/LaunchAgents/com.user.bishop.refresh.plist"

  launchctl bootout "gui/$(id -u)/com.user.bishop.refresh" 2>/dev/null || true
  rm -f "$plist_dest"

  echo "Uninstalled com.user.bishop.refresh"
  exit 0
}

# ---------------------------------------------------------------------------
# Subcommand: --help
# ---------------------------------------------------------------------------

_bishop_help() {
  cat <<'EOF'
bishop — Claude Code budget-posture producer

USAGE
  bishop --refresh              Compute posture from OAuth usage endpoint (or
                                Mother aggregate fallback) and write
                                ~/.claude/budget-posture.json (atomic,
                                idempotent, safe to run concurrently).

  bishop status                 Print human-readable posture summary.
  bishop status --json          Print raw budget-posture.json to stdout.

  bishop get <field>            Print a single field (dot-path supported).
                                E.g.: bishop get posture
                                      bishop get five_hour.level
                                      bishop get models.sonnet.status

  bishop install-agent          Install and start the launchd agent that runs
                                bishop --refresh every 60 seconds.
  bishop uninstall-agent        Stop and remove the launchd agent.

  bishop --help                 Show this help.

POSTURE LEVELS (most urgent → least urgent)
  Pump the brakes  Pace well above expected. Slow down — use cheaper models.
  Ease up          Pace above expected. Consider lighter model selection.
  Cruise           On pace. Normal model selection.
  Push             Pace below expected. Budget headroom available.
  Put the hammer down  Well under pace. Free to use expensive models.

OUTPUT FIELDS (budget-posture.json)
  posture               Top-level posture string (most urgent window wins).
  five_hour / seven_day Per-window objects, each containing:
    used_pct              Usage consumed this window (%).
    elapsed_pct           Time elapsed in window (%).
    pace                  Raw pace ratio (used% / elapsed%; 1.0 = on pace).
    pace_smoothed         Rolling average pace over smooth window, or null if
                          fewer than BISHOP_PACE_SMOOTH_MIN_SAMPLES samples.
                          Drives posture level when non-null.
    projected_exhaustion  ISO 8601 UTC timestamp when quota will reach 100% at
                          current pace, or null if sustainable / window resets
                          before exhaustion.
    resets_at             Epoch when this window resets.
    level                 Posture level for this window.
  billing_mode          "subscription" or "metered" (metered = overage incurred).
  overage               Overage block:
    enabled               true if overage spend is permitted.
    spent_usd             Dollars spent via overage this period, or null.
    monthly_limit_usd     Monthly overage cap in dollars, or null.
    this_session_usd      Reserved; always null.
  subscription          Subscription block:
    plan                  Inferred plan name ("Pro", "Max 5x", "Max 20x"), or
                          null (OAuth endpoint does not report limits directly).
    limits                Token limits per window, or null.
  extra_usage           Raw extra-usage block from OAuth response (backward compat).
  models                Per-model quota objects (OAuth path only).
  exhausted_models      Array of model names at 100% utilization.
  agents                Per-Mother-agent token attribution (OAuth path only),
                        keyed by stage (cody, perri, redd, marty). Each entry:
                        tokens_in_5h, tokens_out_5h, tokens_in_7d, tokens_out_7d
                        summed over succeeded jobs within the window. Only agents
                        with at least one succeeded in-window job appear.
                        Interactive (non-Mother) sessions are not attributable.
                        Always {} on the Mother-aggregate fallback path.

EVENTS (~/.claude/budget-posture.events.jsonl)
  On each refresh, Bishop compares the new posture to the previous posture and
  appends a JSON-lines event whenever a threshold is crossed (edge-triggered).
  No events are emitted on cold start (no previous state to compare against).
  No duplicate events are emitted while a condition persists.

  Each event line is a single JSON object with at least:
    ts        ISO 8601 UTC timestamp of the refresh that detected the crossing.
    type      Always "threshold_crossed".
    window    "five_hour", "seven_day", or "account".
    trigger   One of the five trigger values below.

  Five trigger values:
    pace_critical      five_hour or seven_day level entered "Pump the brakes".
    pace_warning       five_hour or seven_day level entered "Ease up".
    pace_recovered     Level dropped out of "Pump the brakes" or "Ease up".
    exhaustion_imminent  projected_exhaustion crossed under BISHOP_EXHAUSTION_IMMINENT_SECONDS.
    overage_started    billing_mode flipped to "metered" (overage credits now incurred).

  Rotation: when the events file reaches BISHOP_EVENTS_MAX_BYTES (default 1 MB),
  it is renamed to <file>.1 and a new file is started. Active file is always
  written via a tmp + mv — no torn writes.

  Delivery to consumers (tailing, polling, inotify) is out of scope for Bishop.

DATA SOURCES
  Primary: Anthropic OAuth /api/oauth/usage endpoint (per-model visibility).
    Header: anthropic-beta: oauth-2025-04-20
    Auth:   macOS keychain, service "Claude Code-credentials".
  Fallback: ~/.mother/rate-limits.json (Mother aggregate, aggregate-only).

  Requires macOS keychain access. On Linux or where the keychain entry is
  absent, falls back to the Mother aggregate source automatically.

  The launchd agent runs every 60 seconds. Bishop caches the OAuth response
  for BISHOP_USAGE_CACHE_TTL_SECONDS (default 55s) to avoid redundant
  fetches and to degrade gracefully under rate limits (HTTP 429).

ENVIRONMENT VARIABLES
  BISHOP_SOURCE_PATH            Mother aggregate input
                                (default: ~/.mother/rate-limits.json)
  BISHOP_OUTPUT_PATH            Posture output
                                (default: ~/.claude/budget-posture.json)
  BISHOP_SOURCE_STALE_SECONDS   Input age before marking stale_input=true
                                (default: 600)
  BISHOP_DISABLED               Set to any value to skip --refresh entirely.
  BISHOP_NOW_OVERRIDE           Override current epoch (testing).
  BISHOP_MTIME_OVERRIDE         Override source file mtime (testing, legacy path).
  BISHOP_USAGE_FETCH_CMD        Path to bishop-fetch-usage helper
                                (default: alongside bishop binary).
  BISHOP_USAGE_CACHE_PATH       Cached OAuth usage response
                                (default: ~/.claude/oauth-usage.json).
  BISHOP_USAGE_CACHE_TTL_SECONDS  Max age before re-fetching (default: 55).
  BISHOP_PACE_SMOOTH_WINDOW_SECONDS  History horizon for pace smoothing in
                                seconds (default: 2700 = 45 minutes).
  BISHOP_PACE_SMOOTH_MIN_SAMPLES  Minimum samples before emitting pace_smoothed
                                (default: 3). Fewer samples → null.
  BISHOP_MOTHER_RUNS_PATH   Mother per-job metrics log for per-agent token
                            attribution (default: ~/.mother/metrics/runs.jsonl).
                            Bishop reads this file read-only; if missing or
                            unreadable, agents is {} and bishop never crashes.
  BISHOP_EVENTS_PATH            Path to the JSON-lines events file
                                (default: ~/.claude/budget-posture.events.jsonl).
  BISHOP_EVENTS_MAX_BYTES       Events file size cap before rotation in bytes
                                (default: 1048576 = 1 MB).
  BISHOP_EXHAUSTION_IMMINENT_SECONDS  Seconds before projected exhaustion that
                                triggers exhaustion_imminent event
                                (default: 1800 = 30 minutes).
  BISHOP_EVENT_TS_OVERRIDE      Pin event timestamps (testing only).
EOF
  exit 0
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------

CMD="${1:-}"

case "$CMD" in
  --refresh)
    _bishop_refresh
    ;;
  status)
    _bishop_status "${2:-}"
    ;;
  get)
    _bishop_get "${2:-}"
    ;;
  install-agent)
    _bishop_install_agent
    ;;
  uninstall-agent)
    _bishop_uninstall_agent
    ;;
  --help|-h|help)
    _bishop_help
    ;;
  "")
    _bishop_help
    ;;
  *)
    echo "bishop: unknown subcommand: $CMD" >&2
    echo "Run 'bishop --help' for usage." >&2
    exit 1
    ;;
esac
